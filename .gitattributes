# DMXWB repository line-ending policy
#
# Linux/WSL is the supported build/test environment and WB8 is the runtime target.
# Keep repository text files and working-tree text files LF-stable on every host,
# including Windows checkouts with core.autocrlf enabled.
* text=auto eol=lf

# Native Windows command scripts, if added later, keep conventional CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
